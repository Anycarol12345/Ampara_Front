# Copie para .env (ignorado pelo Git).

# Porta do frontend no seu computador
WEB_PORT=8081

# URL da API que o NAVEGADOR acessa. Não use o nome do serviço do Docker aqui.
API_URL=http://localhost:5080

# Opcional: força a funerária, como o subdomínio faria. Vazio = detecta pelo endereço.
TENANT=

# PROVISÓRIO (INF-15): imagem publicada da API
API_IMAGE=ghcr.io/org/ampara-api
API_TAG=latest
API_PORT=5080